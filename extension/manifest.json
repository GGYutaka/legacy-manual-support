{
  "manifest_version": 3,
  "name": "レガシー整備書サポート",
  "short_name": "整備書サポート",
  "version": "1.0.1",
  "description": "非公式。FAINESの古い整備書 (IE専用の閲覧画面・別PDFへリンクするPDF) をChromeで閲覧できるようにします。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://faines.jaspa.or.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "レガシー整備書サポート"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "viewer/*"
      ],
      "matches": [
        "https://faines.jaspa.or.jp/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}